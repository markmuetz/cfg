# readline config -- bash only. zsh does not read this file; the equivalent
# bindings are set with bindkey/zstyle in the "Key bindings" section of ~/.zshrc.
# Keep the two in step.

# PageUp/PageDown
#"\e[5~": history-search-backward
#"\e[6~": history-search-forward
# Cursor keys (last two keep left/right working properly).
"\e[A": history-search-backward
"\e[B": history-search-forward
"\e[C": forward-char
"\e[D": backward-char
Control-k: menu-complete-backward
Control-j: menu-complete
set show-all-if-ambiguous on
set colored-stats on

