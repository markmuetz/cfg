# macOS overrides. Sourced from the end of .shrc.common, so it can undo the GNU
# assumptions made there.
#
# Two paths through this file:
#   1. GNU coreutils installed (brew install coreutils) -- put them on PATH and
#      everything in .shrc.common just works, unchanged.
#   2. Stock BSD userland -- rewrite the handful of aliases that differ.

# Homebrew. Idempotent, and needed here as well as in .zprofile because a
# non-login shell (or bash on macOS) never reads .zprofile.
if [ -z "$HOMEBREW_PREFIX" ]; then
    for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$_brew" ]; then
            eval "$("$_brew" shellenv)"
            break
        fi
    done
    unset _brew
fi

_gnubin="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/coreutils/libexec/gnubin"
if [ -d "$_gnubin" ]; then
    # GNU coreutils available: prefer them, then re-run the colour setup now
    # that dircolors is actually on PATH.
    case ":$PATH:" in
        *":$_gnubin:"*) ;;
        *) export PATH="$_gnubin:$PATH" ;;
    esac
    _shrc_set_colours
else
    # Stock BSD userland: fix up the GNU-only flags used in .shrc.common.
    unalias ls 2>/dev/null
    export CLICOLOR=1
    alias du-sort-dirs="du -h -d 1|sort -hr"
fi
unset _gnubin

# BSD grep understands --color but not --colour.
alias grep='grep --color=auto'
unalias rgrep 2>/dev/null
alias rgrep='grep -r --color=auto'
