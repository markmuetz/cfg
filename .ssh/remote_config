# Ideas taken from: https://research.reading.ac.uk/act/knowledgebase/act-ssh-for-linux-and-mac-users-step-by-step-guide/
# and: https://code.metoffice.gov.uk/doc/monsoon3/ssh.html
# you might need to create the directory ~/.ssh/controlmasters/

Host *
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ForwardX11 yes
  ForwardAgent yes

# Monsoon3
# ========
Host monsoon*
  User mark.muetzelfeldt.ext

Host monsoonlander monsoonlander1 monsoonlander2
  # %h is hostname *as typed*. Full hostname is too long
  ControlPath ~/.ssh/controlmasters/mo_%n:%p
  # Works but %C is the hash of the details.
  # ControlPath ~/.ssh/controlmasters/mo_master-%C
  ControlMaster auto
  # In seconds.
  ControlPersist 20000

Host monsoonlander1
  Hostname lander1.collab.sc.metoffice.gov.uk

Host monsoonlander2
  Hostname lander2.collab.sc.metoffice.gov.uk

# Generic, gets assigned a login node login01-12
Host monsoonhpc
  Hostname login
  IdentityFile ~/.ssh/id_ed25519_monsoon3
  ProxyJump monsoonlander1

# Means I can e.g. ssh login10 and get directed straight to that server on Monsoon3
# Required for persistent tmux sessions.
Host login??
  User mark.muetzelfeldt.ext
  IdentityFile ~/.ssh/id_ed25519_monsoon3
  ProxyJump monsoonlander1

