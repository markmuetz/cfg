# JASMIN
# ======
Host *.jasmin.ac.uk
  User mmuetz
  ProxyJump JasminLogin2
  # These 3 allow for one master ssh connection to be made, and passwords are stored.
  # %r username
  # %h is remote hostname
  # %p is remote port
  # %l is local hostname but no need to show. 
  ControlPath ~/.ssh/controlmasters/jas_%r@%h:%p
  ControlMaster auto
  ControlPersist yes

# No restrictions on access now, both will work:
# https://help.jasmin.ac.uk/docs/interactive-computing/login-problems/
Host JasminLogin1
  HostName login-01.jasmin.ac.uk
  User mmuetz

Host JasminLogin2
  HostName login-02.jasmin.ac.uk
  User mmuetz

