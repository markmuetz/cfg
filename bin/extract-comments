#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["pymupdf>=1.24"]
# ///
"""Extract the comments (annotations) from a PDF into <name>_comments.md.

Every annotation is included: sticky notes, text boxes, highlights,
underlines, strike-outs, insertion marks and drawings, with the author, the
date and any replies, which are nested under the comment they answer. Comments
are grouped by page in reading order. Manuscript text is quoted only for
corrections: the text a strike-out deletes, and the text an insertion mark
adds. Every other comment is located by line number alone, with your comment
text but none of the text it marks or sits beside. Freehand drawings (pen
strokes, e.g. from an iPad) are left out unless --drawings is given: they
carry no text.

Each comment is located by manuscript line number when the PDF has them: the
column of rising numbers in the margin is found and every comment is placed
against it ("L45–46"), interpolating when only every 5th line is numbered.
Without line numbers, comments are located by page only.

With --review it also writes <name>_review.md, a skeleton referee report:
Summary and Recommendation (for you to write), then Major comments, Minor
comments and Technical corrections, each a numbered list of 'L45: <comment>'.
Start a comment with M:, m: or t: to put it in a section (untagged comments
are minor). The text a strike-out deletes is quoted with its comment as the
replacement ('"old" → new'), and an insertion reads 'insert "<text>"'; no
other manuscript text goes in. Marks with no comment are listed at the end as
reminders.

Comments with no line number are located by page ("p2"): they sit outside the
numbered text (a margin, a figure), or no line numbers were found on the page.
--debug-lines prints which, page by page (positions only, no text).

Runs locally: nothing is sent anywhere.

Usage:
    extract-comments paper.pdf               # writes ./paper_comments.md
    extract-comments paper.pdf -o notes/     # writes notes/paper_comments.md
    extract-comments paper.pdf --print       # and prints it
    extract-comments paper.pdf --skip-bare   # leave out marks with no comment
    extract-comments paper.pdf --review      # also ./paper_review.md

Needs uv (it runs as a uv script and fetches PyMuPDF on first use).
Tests: ~/bin/tests/extract_comments/test_extract_comments.py (needs pdflatex).

Provenance
----------
Written on 2026-09-25 by Claude (Claude Code, model Claude Opus 5.5) for Mark
Muetzelfeldt, alongside analyse-citations, whose margin line-number detection
it follows. Tested on a line-numbered LaTeX fixture annotated with PyMuPDF.
2026-10-21: at MM's request, only strike-outs and insertions quote text;
highlights and the "near" text of notes and boxes were dropped, so that a
report built from the output carries only line numbers and MM's own words.
"""
import argparse
import re
import statistics
import sys
from collections import Counter
from dataclasses import dataclass, field
from datetime import date
from pathlib import Path

import pymupdf

SKIP = {"Link", "Widget", "Popup"}
MARKUP = {"Highlight", "Underline", "StrikeOut", "Squiggly"}
QUOTED = {"StrikeOut"}         # the only marks whose text is quoted
KIND = {"Text": "Note", "FreeText": "Text box", "Highlight": "Highlight",
        "Underline": "Underline", "StrikeOut": "Strike-out", "Squiggly": "Squiggly",
        "Caret": "Insert", "Ink": "Drawing", "Square": "Box", "Circle": "Circle",
        "Line": "Line", "Polygon": "Polygon", "PolyLine": "Polyline", "Stamp": "Stamp",
        "FileAttachment": "Attachment", "Sound": "Sound"}


@dataclass
class Comment:
    page: int                  # 1-based
    kind: str
    y0: float
    y1: float
    x0: float
    author: str
    when: str
    text: str
    quoted: str
    xref: int
    irt: int                   # xref of the comment this one replies to, or 0
    rect: tuple = ()           # the annotation's (x0, y0, x1, y1)
    lines: tuple = None        # (first, last) manuscript line numbers
    replies: list = field(default_factory=list)


# --- margin line numbers -----------------------------------------------------

def rising(nums):
    """How many steps go up by 1 to 10 (10 when every 10th line is numbered)."""
    return sum(0 < b - a <= 10 for a, b in zip(nums, nums[1:]))


def margin_numbers(doc, debug=None):
    """{page: [(y, number), ...]} for the manuscript line numbers, or {}.

    Line numbers are right-aligned in one margin column: small integers
    sharing a right edge, rising down the page. The column is found page by
    page, since it can shift between pages (mirrored margins, numbers stamped
    by a submission system). Both margins are tried. `debug`, a list, collects
    a line per page saying what was found (positions and counts only).
    """
    hits = []                  # (side, right edge, page, y centre, number)
    for pno, page in enumerate(doc, 1):
        w = page.rect.width
        for x0, y0, x1, y1, word, *_ in page.get_text("words"):
            if re.fullmatch(r"\d{1,5}", word):
                side = "left" if x1 < 0.25 * w else "right" if x0 > 0.75 * w else None
                if side:
                    hits.append((side, round(x1), pno, (y0 + y1) / 2, int(word)))
    best, best_log = {}, []
    for side in ("left", "right"):
        sel, log = [], []
        for pno in range(1, len(doc) + 1):
            ph = [h for h in hits if h[0] == side and h[2] == pno]
            cols = Counter(h[1] for h in ph)
            if not cols:
                log.append(f"page {pno}: {side}: no numbers in the margin")
                continue
            col = cols.most_common(1)[0][0]
            col_hits = sorted((h for h in ph if abs(h[1] - col) <= 2), key=lambda h: h[3])
            nums = [h[4] for h in col_hits]
            ok = len(nums) >= 3 and rising(nums) >= 0.8 * (len(nums) - 1)
            log.append(f"page {pno}: {side} column at x={col}: {len(nums)} numbers"
                       + (f" ({nums[0]}–{nums[-1]})" if nums else "")
                       + ("" if ok else ", rejected (too few, or not rising)"))
            if ok:
                sel += col_hits
        if len(sel) >= 10 and len(sel) > len(best.get("sel", [])):
            best, best_log = {"sel": sel}, log
    if debug is not None:
        debug.extend(best_log or ["no column of rising line numbers found"])
    pages = {}
    for _, _, pno, y, n in best.get("sel", []):
        pages.setdefault(pno, []).append((y, n))
    return pages


def line_at(points, y):
    """Line number at height y, interpolated between the numbered lines around
    it; None if y is well outside the numbered text (a header or margin)."""
    if not points:
        return None
    if len(points) == 1:
        return points[0][1]
    steps = [(y2 - y1) / (n2 - n1) for (y1, n1), (y2, n2) in zip(points, points[1:]) if n2 > n1]
    spacing = statistics.median(steps) if steps else 12
    # Text can run up to one numbering step past the first and last printed
    # numbers on a page (4 lines when every 5th line is numbered).
    every = statistics.median([n2 - n1 for (_, n1), (_, n2) in zip(points, points[1:])] or [1])
    reach = (every + 0.5) * spacing
    if y < points[0][0] - reach or y > points[-1][0] + reach:
        return None
    for (ya, na), (yb, nb) in zip(points, points[1:]):
        if y <= yb or (yb, nb) == points[-1]:
            break
    return max(1, round(na + (y - ya) * (nb - na) / (yb - ya))) if yb != ya else na


# --- annotations -------------------------------------------------------------

def when(info):
    """'D:20260925114503+01'00'' -> '2026-09-25 11:45'."""
    d = info.get("modDate") or info.get("creationDate") or ""
    m = re.match(r"D?:?(\d{4})(\d{2})(\d{2})(\d{2})?(\d{2})?", d)
    if not m:
        return ""
    y, mo, dd, hh, mi = m.groups()
    return f"{y}-{mo}-{dd}" + (f" {hh}:{mi}" if hh and mi else "")


def quoted_text(page, annot, words):
    """The text a strike-out (or other text markup) marks: the whole words
    whose centre lies in one of its quads (one quad per marked line), each
    word once, in reading order."""
    v = annot.vertices or []
    quads = [pymupdf.Quad(v[i:i + 4]).rect for i in range(0, len(v) - 3, 4)]
    hit = []
    for w in words:
        inside = [q for q in quads if pymupdf.Point((w[0] + w[2]) / 2, (w[1] + w[3]) / 2) in q]
        if not inside:
            continue
        # A mark that stops before the word does ("(2022)" of "(2022).") leaves
        # out its trailing punctuation.
        if w[2] > max(q.x1 for q in inside) + 1:
            w = (*w[:4], w[4].rstrip(".,;:"), *w[5:])
        hit.append(w)
    return join_words(sorted(hit, key=lambda w: (w[5], w[6], w[7])))


def join_words(words):
    """Join words, undoing hyphenation at line ends: "comprehen-" + "sive"
    -> "comprehensive"; "IM-" + "ERG" keeps its hyphen ("IM-ERG")."""
    out = ""
    for i, w in enumerate(words):
        text = w[4]
        prev = words[i - 1] if i else None
        if prev and prev[4].endswith("-") and (prev[5], prev[6]) != (w[5], w[6]):
            out = (out[:-1] if text[:1].islower() else out) + text
        else:
            out += (" " if out else "") + text
    return out


def page_words(page):
    """The page's printed words, without those of text-box annotations, which
    PyMuPDF extracts along with the page text."""
    boxes = [(a.rect, set((a.info.get("content") or "").split()))
             for a in page.annots() if a.type[1] == "FreeText"]
    return [w for w in page.get_text("words")
            if not any(pymupdf.Point((w[0] + w[2]) / 2, (w[1] + w[3]) / 2) in r and w[4] in t
                       for r, t in boxes)]


def extract(path, drawings=False, debug=None):
    doc = pymupdf.open(path)
    numbers = margin_numbers(doc, debug)
    comments = []
    for pno, page in enumerate(doc, 1):
        words = page_words(page)
        for annot in page.annots():
            kind = annot.type[1]
            if kind in SKIP or (kind == "Ink" and not drawings):
                continue
            info = annot.info
            r = annot.rect
            if kind in MARKUP and annot.vertices:
                # Locate by the first and last marked lines, not the bounding box.
                qs = [pymupdf.Quad(annot.vertices[i:i + 4]).rect
                      for i in range(0, len(annot.vertices) - 3, 4)]
                ya, yb = (qs[0].y0 + qs[0].y1) / 2, (qs[-1].y0 + qs[-1].y1) / 2
            elif kind in ("Text", "Caret"):
                ya = yb = (r.y0 + r.y1) / 2      # an icon: its middle
            elif kind == "FreeText":
                ya = yb = r.y0 + 4               # a text box points from its top edge
            else:
                ya, yb = r.y0 + 2, r.y1 - 2
            c = Comment(pno, KIND.get(kind, kind), min(ya, yb), max(ya, yb), r.x0,
                        info.get("title", "").strip(), when(info),
                        (info.get("content") or "").strip(),
                        quoted_text(page, annot, words) if kind in QUOTED else "",
                        annot.xref, getattr(annot, "irt_xref", 0) or 0, (r.x0, r.y0, r.x1, r.y1))
            comments.append(c)
    by_xref = {c.xref: c for c in comments}
    top = []
    for c in comments:
        parent = by_xref.get(c.irt)
        (parent.replies if parent else top).append(c)
    for c in top:
        merge_replacement(c)
    top.sort(key=lambda c: (c.page, round(c.y0), c.x0))
    for c in top + [r for c in top for r in c.replies]:
        pts = numbers.get(c.page, [])
        first, last = line_at(pts, c.y0), line_at(pts, c.y1)
        if first:
            c.lines = (first, last or first)
        elif debug is not None:
            span = f"numbered lines at y={pts[0][0]:.0f}–{pts[-1][0]:.0f}" if pts else "no line numbers on this page"
            debug.append(f"page {c.page}: {c.kind} at y={c.y0:.0f}–{c.y1:.0f}: no line ({span})")
    return top, bool(numbers), len(comments)


# --- output ------------------------------------------------------------------

def where(c):
    """'L45', 'L45–46', or 'p3' where there is no line number."""
    if not c.lines:
        return f"p{c.page}"
    a, b = c.lines
    return f"L{a}" if a == b else f"L{a}–{b}"


def byline(c):
    who = ", ".join(x for x in (c.author, c.when) if x)
    return f" — *{who}*" if who else ""


def block(text, indent):
    return "\n".join(f"{indent}{line}" if line.strip() else indent.rstrip() for line in text.split("\n"))


def merge_replacement(c):
    """Acrobat's "Replace text" is a strike-out and an insertion, one replying
    to the other: make them one strike-out whose text is the replacement."""
    other = "Insert" if c.kind == "Strike-out" else "Strike-out" if c.kind == "Insert" else None
    pair = next((r for r in c.replies if r.kind == other), None)
    if not pair:
        return
    strike, ins = (c, pair) if c.kind == "Strike-out" else (pair, c)
    if strike.text and ins.text:
        return                 # a strike-out with its own comment: keep both
    c.kind, c.quoted, c.text = "Strike-out", strike.quoted, strike.text or ins.text
    c.replies.remove(pair)


def arrow(c, text):
    """'"deleted text" → replacement'; '(delete)' when there is none."""
    return f'"{c.quoted}" \u2192 {text or "(delete)"}'


def body(c, indent):
    """A comment's text. A strike-out reads '"old" → new' (its comment is the
    new text; a tag such as "t:" stays in front); an insertion's text is what
    it inserts, so it is quoted."""
    if c.kind == "Strike-out":
        m = TAG_RE.match(c.text)
        tag, text = (m.group(0), c.text[m.end():]) if m else ("", c.text)
        return [block(tag + arrow(c, text), indent)]
    if c.text:
        return [block("> " + c.text if c.kind == "Insert" else c.text, indent)]
    return []


def to_markdown(path, top, numbered, total, skip_bare=False):
    shown = [c for c in top if not (skip_bare and not c.text and not c.replies)]
    replies = sum(len(c.replies) for c in top)
    out = [f"# Comments: {path.name}\n",
           f"{len(shown)} comments" + (f" and {replies} repl{'y' if replies == 1 else 'ies'}"
                                        if replies else "") +
           f" on {len({c.page for c in shown})} pages. Located by "
           + ("manuscript line number." if numbered else "page (the PDF has no line numbers).")
           + f" Extracted {date.today().isoformat()} by extract-comments.\n"]
    page = None
    for c in shown:
        if c.page != page:
            page = c.page
            out.append(f"## Page {page}\n")
        out.append(f"- **{where(c)}** {c.kind}{byline(c)}")
        out.extend(body(c, "  "))
        for r in c.replies:
            # A strike-out or insertion replying to another one keeps its own label.
            out.append(f"  - {'Reply' if r.kind in ('Note', 'Text box') else r.kind}{byline(r)}")
            out.extend(body(r, "    "))
        out.append("")
    return "\n".join(out)


# --- review draft ------------------------------------------------------------

# A tag at the start of a comment sorts it into a section of the review.
# Single letters are case-sensitive (M major, m minor); words are not.
TAG_RE = re.compile(r"^\s*(M|m|t|T|major|maj|minor|min|technical|tech|typo)\s*[:.)]\s*", re.I)
SECTIONS = [("major", "Major comments"), ("minor", "Minor comments"),
            ("technical", "Technical corrections")]


def section_of(text):
    """('major' | 'minor' | 'technical', text without its tag). Untagged: minor."""
    m = TAG_RE.match(text)
    if not m:
        return "minor", text
    tag = m.group(1)
    if tag == "M" or tag.lower() in ("major", "maj"):
        kind = "major"
    elif tag == "m" or tag.lower() in ("minor", "min"):
        kind = "minor"
    else:
        kind = "technical"
    return kind, text[m.end():]


def review_text(c, text):
    """'"deleted text" → new text', 'insert "text"', or the comment alone; later
    lines of a multi-line comment are indented under it."""
    if c.kind == "Insert":
        text = f'insert "{text}"'
    elif c.kind == "Strike-out":
        text = arrow(c, text)
    first, *rest = (text or "(no text)").split("\n")
    return "\n".join([first] + [f"   {line}" for line in rest])


def to_review(path, top, numbered):
    """A skeleton review in the usual form, from the comments alone.

    Each item is the reviewer's comment; a strike-out reads '"<deleted
    text>" → <its comment>', and an insertion 'insert "<text>"'. No other
    manuscript text goes in. Marks with no comment are listed at the end as
    reminders.
    """
    items = {k: [] for k, _ in SECTIONS}
    bare = []
    for c in top:
        if not c.text:
            if c.replies:
                items["minor"].append((c, ""))
            else:
                bare.append(c)
            continue
        kind, text = section_of(c.text)
        items[kind].append((c, text))
    out = [f"# Review of {path.stem}\n",
           "<!-- Draft assembled by extract-comments --review from the comments in the "
           "PDF: your comments, located by line, with deleted and inserted text in double quotes. Tag "
           "comments M: (major), "
           "m: (minor) or t: (technical); untagged ones are minor. Write the summary "
           "and recommendation yourself, and expand any shorthand. -->\n",
           "## Summary\n", "_Summarise the manuscript and give your overall assessment._\n",
           "## Recommendation\n", "_Accept / minor revision / major revision / reject._\n"]
    for key, title in SECTIONS:
        out.append(f"## {title}\n")
        if not items[key]:
            out.append("_None._\n")
            continue
        for i, (c, text) in enumerate(items[key], 1):
            out.append(f"{i}. {where(c)}: {review_text(c, text)}")
            for r in c.replies:
                if r.text or r.quoted:
                    who = f" ({r.author})" if r.author else ""
                    label = "Reply" if r.kind in ("Note", "Text box") else r.kind
                    out.append(block(f"- {label}{who}: {review_text(r, r.text)}", "   "))
        out.append("")
    if bare:
        out.append("## Marks without a comment (reminders; not part of the review)\n")
        for c in bare:
            quote = f' "{c.quoted}"' if c.quoted else ""
            out.append(f"- {where(c)}: {c.kind.lower()}{quote}")
            for r in c.replies:
                if r.text or r.quoted:
                    out.append(f"  - {r.kind.lower()}: {review_text(r, r.text)}")
        out.append("")
    if not numbered:
        out.append("<!-- The PDF has no line numbers: items are located by page only. -->\n")
    return "\n".join(out)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\nProvenance\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("file", type=Path, help="the PDF")
    ap.add_argument("-o", "--out", type=Path, metavar="DIR", default=Path("."),
                    help="output directory (default: the current one)")
    ap.add_argument("--print", action="store_true", help="also print the markdown")
    ap.add_argument("--drawings", action="store_true",
                    help="include freehand drawings (pen strokes), left out by default")
    ap.add_argument("--skip-bare", action="store_true",
                    help="leave out highlights and other marks that have no comment text")
    ap.add_argument("--debug-lines", action="store_true",
                    help="explain the line numbering: per page, the margin column found, and "
                         "why any comment has no line number (positions only, no text)")
    ap.add_argument("--review", action="store_true",
                    help="also write <name>_review.md, a skeleton review from the comments "
                         "(tag them M:, m: or t: for major, minor, technical)")
    args = ap.parse_args()
    debug = [] if args.debug_lines else None
    top, numbered, total = extract(args.file, args.drawings, debug)
    if debug is not None:
        print("\n".join(debug), file=sys.stderr)
    md = to_markdown(args.file, top, numbered, total, args.skip_bare)
    args.out.mkdir(parents=True, exist_ok=True)
    dest = args.out / f"{args.file.stem}_comments.md"
    dest.write_text(md)
    if args.print:
        print(md)
    print(f"Wrote {dest}: {total} annotation{'' if total == 1 else 's'}"
          + ("" if numbered else " (no line numbers found: located by page)"), file=sys.stderr)
    if args.review:
        review = args.out / f"{args.file.stem}_review.md"
        review.write_text(to_review(args.file, top, numbered))
        print(f"Wrote {review}", file=sys.stderr)


if __name__ == "__main__":
    main()
